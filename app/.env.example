# Copia a .env. No compartas ese archivo ni lo incluyas en un repositorio.
API_MODE=demo
# Modelo habilitado en tu cuenta y comprobado con el esquema del laboratorio.
OPENAI_MODEL=
OPENAI_API_KEY=
# Requerido para serve. Genera con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
SALES_DB=sales_lab.sqlite3
# Solo cambia a 1 después de configurar y probar un único consumidor de salida.
DELIVER_OUTBOX=0
